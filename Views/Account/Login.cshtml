@model GamePrice.Models.LoginViewModel
@{
    ViewData["Title"] = "Entrar";
}

<section class="auth-shell">
    <div class="auth-panel">
        <header class="auth-panel-header">
            <a class="site-brand" asp-controller="Home" asp-action="Index">
                <img class="site-brand-logo" src="~/img/brand/gameprice-logo.svg" alt="GamePrice" width="184" height="44" asp-append-version="true" />
            </a>
            <h1>Entrar na sua conta</h1>
            <p>Acesse sua lista de desejos e seus alertas.</p>
        </header>

        <form asp-controller="Login" asp-action="Login" method="post" novalidate>
            <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label">Email</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-envelope" aria-hidden="true"></i></span>
                    <input asp-for="Email" class="form-control" placeholder="voce@exemplo.com" autocomplete="email" />
                </div>
                <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label">Senha</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-lock" aria-hidden="true"></i></span>
                    <input asp-for="Password" type="password" class="form-control" placeholder="Sua senha" autocomplete="current-password" />
                </div>
                <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
            </div>

            <div class="form-check mb-4">
                <input asp-for="RememberMe" class="form-check-input" />
                <label asp-for="RememberMe" class="form-check-label">Manter conectado</label>
            </div>

            <button type="submit" class="btn btn-primary w-100">
                <i class="bi bi-box-arrow-in-right" aria-hidden="true"></i>
                Entrar
            </button>
        </form>

        <p class="auth-footer">Ainda não tem conta? <a asp-controller="Register" asp-action="Register">Cadastre-se</a></p>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
