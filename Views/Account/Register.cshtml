@model GamePrice.Models.RegisterViewModel
@{
    ViewData["Title"] = "Criar conta";
}

<section class="auth-shell">
    <div class="auth-panel">
        <header class="auth-panel-header">
            <a class="site-brand" asp-controller="Home" asp-action="Index">
                <img class="site-brand-logo" src="~/img/brand/gameprice-logo.svg" alt="GamePrice" width="184" height="44" asp-append-version="true" />
            </a>
            <h1>Criar uma conta</h1>
            <p>Salve jogos e acompanhe os preços que importam para você.</p>
        </header>

        <form asp-controller="Register" asp-action="Register" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

            <div class="mb-3">
                <label asp-for="Name" class="form-label">Nome</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-person" aria-hidden="true"></i></span>
                    <input asp-for="Name" class="form-control" placeholder="Seu nome" autocomplete="name" />
                </div>
                <span asp-validation-for="Name" class="text-danger small mt-1 d-block"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label">Email</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-envelope" aria-hidden="true"></i></span>
                    <input asp-for="Email" class="form-control" placeholder="voce@exemplo.com" autocomplete="email" />
                </div>
                <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label">Senha</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-lock" aria-hidden="true"></i></span>
                    <input asp-for="Password" type="password" class="form-control" placeholder="Mínimo de 6 caracteres" autocomplete="new-password" />
                </div>
                <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
            </div>

            <div class="mb-4">
                <label asp-for="ConfirmPassword" class="form-label">Confirmar senha</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-lock" aria-hidden="true"></i></span>
                    <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="Repita a senha" autocomplete="new-password" />
                </div>
                <span asp-validation-for="ConfirmPassword" class="text-danger small mt-1 d-block"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100">
                <i class="bi bi-person-plus" aria-hidden="true"></i>
                Criar conta
            </button>
        </form>

        <p class="auth-footer">Já tem uma conta? <a asp-controller="Login" asp-action="Login">Entrar</a></p>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
