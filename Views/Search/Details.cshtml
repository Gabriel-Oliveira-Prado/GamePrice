@model List<GamePrice.Api.Domain.DTOs.PythonStoreResultDto>
@{
    var gameName = ViewBag.GameName as string ?? Model?.FirstOrDefault()?.Nome ?? "Detalhes do jogo";
    ViewData["Title"] = $"{gameName}, comparação de preços";
    var gameImage = Model?.FirstOrDefault(item => !string.IsNullOrWhiteSpace(item.Imagem))?.Imagem;
    var gameDescription = Model?.FirstOrDefault(item => !string.IsNullOrWhiteSpace(item.Descricao))?.Descricao;
}

@functions {
    public string CleanPrice(string? price)
    {
        if (string.IsNullOrWhiteSpace(price)) return "Preço indisponível";
        return price
            .Replace("Preço normal:", "")
            .Replace("Preço promocional:", "")
            .Replace("Preço normal\r\n", "")
            .Replace("Preço promocional\r\n", "")
            .Replace("Preço normal\n", "")
            .Replace("Preço promocional\n", "")
            .Trim();
    }

    public double PriceValue(string? price)
    {
        try
        {
            var cleaned = CleanPrice(price);
            if (cleaned.Contains("grátis", StringComparison.OrdinalIgnoreCase)
                || cleaned.Contains("gratuito", StringComparison.OrdinalIgnoreCase)) return 0;
            var match = System.Text.RegularExpressions.Regex.Match(
                cleaned,
                @"\d{1,3}(?:\.\d{3})*,\d{2}|\d+(?:[.,]\d{1,2})?");
            if (!match.Success) return double.MaxValue;
            return double.Parse(match.Value, System.Globalization.CultureInfo.GetCultureInfo("pt-BR"));
        }
        catch
        {
            return double.MaxValue;
        }
    }
}

@{
    var stores = Model?
        .Where(item => !string.IsNullOrWhiteSpace(item.Plataforma))
        .GroupBy(item => item.Plataforma!.Trim(), StringComparer.OrdinalIgnoreCase)
        .Select(group => group.OrderBy(item => PriceValue(item.PrecoAtual)).First())
        .OrderBy(item => PriceValue(item.PrecoAtual))
        .ToList()
        ?? new List<GamePrice.Api.Domain.DTOs.PythonStoreResultDto>();
}

<section class="page-shell">
    <div class="container site-container">
        @await Html.PartialAsync("_Breadcrumb", gameName)

        @if (stores.Count == 0)
        {
            <div class="error-panel">
                <i class="bi bi-exclamation-circle" aria-hidden="true"></i>
                <h1>Preço não encontrado</h1>
                <p>Não encontramos uma oferta oficial para "@gameName" neste momento.</p>
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Buscar outro jogo</a>
            </div>
        }
        else
        {
            <div class="details-layout">
                <div class="game-cover details-image">
                    @if (!string.IsNullOrWhiteSpace(gameImage))
                    {
                        <img src="@gameImage" alt="Capa de @gameName" onerror="this.parentElement.classList.add('image-missing'); this.remove();" />
                    }
                </div>
                <div class="details-copy">
                    <p class="eyebrow">@stores.Count @(stores.Count == 1 ? "loja encontrada" : "lojas encontradas")</p>
                    <h1>@gameName</h1>
                    @if (!string.IsNullOrWhiteSpace(gameDescription))
                    {
                        <p class="game-description">@gameDescription</p>
                    }
                    <p class="details-purchase-note">Compare os valores abaixo e confirme preço, edição e disponibilidade no site da loja antes da compra.</p>
                    <div class="details-actions">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <form asp-controller="Wishlist" asp-action="Add" method="post">
                                <input type="hidden" name="gameName" value="@gameName" />
                                <input type="hidden" name="returnUrl" value="@($"{Context.Request.Path}{Context.Request.QueryString}")" />
                                <button type="submit" class="btn btn-primary">
                                    <i class="bi bi-bookmark-plus" aria-hidden="true"></i>
                                    Salvar na lista
                                </button>
                            </form>
                        }
                        else
                        {
                            <a asp-controller="Login" asp-action="Login" asp-route-returnUrl="@($"{Context.Request.Path}{Context.Request.QueryString}")" class="btn btn-primary">
                                <i class="bi bi-bookmark" aria-hidden="true"></i>
                                Entrar para salvar
                            </a>
                        }
                    </div>
                </div>
            </div>

            <div class="section-heading compact-heading">
                <div>
                    <p class="eyebrow">Do menor para o maior</p>
                    <h2>Comparação de preços</h2>
                </div>
            </div>

            <div class="comparison-list">
                <div class="comparison-header" aria-hidden="true">
                    <span>Loja</span>
                    <span class="comparison-price-heading">Preço</span>
                    <span>Acesso</span>
                </div>
                @foreach (var store in stores)
                {
                    var currentPrice = CleanPrice(store.PrecoAtual);
                    var originalPrice = CleanPrice(store.PrecoOriginal);
                    <div class="comparison-row">
                        <div class="comparison-store">
                            @await Html.PartialAsync("_StoreIcon", store.Plataforma ?? string.Empty)
                            <span>@store.Plataforma</span>
                        </div>
                        <div class="comparison-price">
                            @if (originalPrice != "Preço indisponível" && originalPrice != currentPrice)
                            {
                                <del>@originalPrice</del>
                            }
                            <strong>@currentPrice</strong>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(store.Link))
                        {
                            <a href="@store.Link" target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-sm">
                                Abrir loja
                                <i class="bi bi-arrow-up-right" aria-hidden="true"></i>
                            </a>
                        }
                        else
                        {
                            <span class="btn btn-outline-secondary btn-sm disabled" aria-disabled="true">Link indisponível</span>
                        }
                    </div>
                }
            </div>
        }
    </div>
</section>
