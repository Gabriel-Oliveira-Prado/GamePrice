<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GamePrice</title>

    @* Fonts *@
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet">

    @* Bootstrap & Icons *@
    <link rel="stylesheet" href="/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    @* Swiper CSS *@
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />

    @* Custom CSS *@
    @* Custom CSS *@
    <link rel="stylesheet" href="/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="d-flex flex-column min-vh-100">

    @* Preloader *@
    <div class="loader-container" aria-hidden="false">
        <div class="loader-overlay"></div>
        <div class="loader-content text-center" role="status" aria-live="polite">
            <div class="loader-brand">
                <svg class="logo-svg mb-2 text-primary" viewBox="0 0 640 512" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <path class="logo-path" d="M192 64C86 64 0 150 0 256S86 448 192 448H448c106 0 192-86 192-192s-86-192-192-192H192zM496 168c26.5 0 48 21.5 48 48s-21.5 48-48 48-48-21.5-48-48 21.5-48 48-48zm-32 128c26.5 0 48 21.5 48 48s-21.5 48-48 48-48-21.5-48-48 21.5-48 48-48zM192 160v48h48c13.3 0 24 10.7 24 24s-10.7 24-24 24H192v48c0 13.3-10.7 24-24 24s-24-10.7-24-24V256H96c-13.3 0-24-10.7-24-24s10.7-24 24-24h48V160c0-13.3 10.7-24 24-24s24 10.7 24 24z" />
                </svg>
            </div>
            <h2 class="text-white fw-bold mb-2 mt-1 loader-text">Game<span class="text-primary">Price</span></h2>
            <p class="loader-subtext text-white-50 mb-3">Carregando recursos, quase lá...</p>
            <div class="loading-bar-container" aria-hidden="true"><div class="loading-bar"></div></div>
                <button type="button" class="btn btn-sm btn-light mt-3 loader-skip-btn" style="display:none;">Continuar</button>
        </div>
    </div>

    @* Background Glow Interativo *@
    <div class="hero-bg-glow"></div>

    @* Navbar *@
    <nav class="navbar navbar-expand-lg fixed-top floating-navbar">
        <div class="container">
            <a class="navbar-brand text-white" asp-area="" asp-controller="Home" asp-action="Index">
                <i class="fas fa-gamepad me-2"></i>Game<span>Price</span>
            </a>
            <button class="navbar-toggler navbar-dark border-0 p-1" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto align-items-center">
                    <li class="nav-item"><a class="nav-link px-3" href="#features">Recursos</a></li>
                    <li class="nav-item"><a class="nav-link px-3" href="#deals">Ofertas</a></li>
                    <li class="nav-item ms-lg-3 mt-3 mt-lg-0">
                        <a href="#" class="btn btn-primary btn-login" data-bs-toggle="modal" data-bs-target="#loginModal">Entrar</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    @RenderBody()

    <partial name="_LoginModal" />

    @* Footer *@
    <footer class="footer">
        <div class="container">
            <div class="row gy-4">
                <div class="col-lg-4 col-md-6 text-center text-md-start">
                    <a class="footer-brand text-white text-decoration-none" href="#">
                        <i class="fas fa-gamepad me-2"></i>Game<span>Price</span>
                    </a>
                    <p class="footer-text">
                        Sua plataforma definitiva para encontrar os melhores preços de jogos digitais. Economize em cada compra e jogue mais.
                    </p>
                    <div class="social-links justify-content-center justify-content-md-start">
                        <a href="#" class="social-link" aria-label="Twitter"><i class="fab fa-twitter"></i></a>
                        <a href="#" class="social-link" aria-label="Instagram"><i class="fab fa-instagram"></i></a>
                        <a href="#" class="social-link" aria-label="Discord"><i class="fab fa-discord"></i></a>
                        <a href="#" class="social-link" aria-label="YouTube"><i class="fab fa-youtube"></i></a>
                    </div>
                </div>

                <div class="col-lg-2 col-md-6 text-center text-md-start">
                    <h5 class="footer-subtitle">Navegação</h5>
                    <ul class="footer-links">
                        <li><a href="#features">Recursos</a></li>
                        <li><a href="#deals">Ofertas</a></li>
                        <li><a href="#">App Mobile</a></li>
                        <li><a href="#">Blog</a></li>
                    </ul>
                </div>

                <div class="col-lg-2 col-md-6 text-center text-md-start">
                    <h5 class="footer-subtitle">Suporte</h5>
                    <ul class="footer-links">
                        <li><a href="#">Central de Ajuda</a></li>
                        <li><a href="#">Termos de Uso</a></li>
                        <li><a asp-controller="Home" asp-action="Privacy">Privacidade</a></li>
                        <li><a href="#">Contato</a></li>
                    </ul>
                </div>

                <div class="col-lg-4 col-md-6 text-center text-md-start">
                    <h5 class="footer-subtitle">Contato</h5>
                    <ul class="footer-contact">
                        <li class="justify-content-center justify-content-md-start">
                            <i class="fas fa-envelope"></i>
                            <span>Gabrieloliveira.prado@hotmail.com</span>
                        </li>
                        <li class="justify-content-center justify-content-md-start">
                            <i class="fas fa-phone"></i>
                            <span>+55 81 8510-2009</span>
                        </li>
                        <li class="justify-content-center justify-content-md-start">
                            <i class="fas fa-map-marker-alt"></i>
                            <span>Recife, Brasil</span>
                        </li>
                    </ul>
                </div>
            </div>

            <hr class="footer-divider">

            <div class="row align-items-center">
                <div class="col-12 text-center">
                    <p class="footer-copyright mb-0">&copy; 2026 GamePrice. Todos os direitos reservados.</p>
                </div>
            </div>
        </div>
    </footer>

    <script src="/lib/jquery/dist/jquery.min.js"></script>
    <script src="/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/particles.js/2.0.0/particles.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/animejs/3.2.1/anime.min.js"></script>
    @* Swiper JS *@
    <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
    @* Custom JS *@
    <script src="/js/navbar.js" asp-append-version="true"></script>
    <script src="/js/search.js" asp-append-version="true"></script>
    <script src="/js/auth-modal.js" asp-append-version="true"></script>
    <script src="/js/loader.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>