@using System.Security.Claims
@{
    var accountEmail = User.FindFirstValue(ClaimTypes.Email);
    var accountName = User.FindFirstValue(ClaimTypes.GivenName) ?? User.Identity?.Name;
    if (string.IsNullOrWhiteSpace(accountName)
        || string.Equals(accountName, accountEmail, StringComparison.OrdinalIgnoreCase))
    {
        accountName = "Minha conta";
    }

    var feedbackError = TempData["ErrorMessage"] as string ?? ViewData["ErrorMessage"] as string;
    var feedbackSuccess = TempData["SuccessMessage"] as string ?? ViewData["SuccessMessage"] as string;
    var feedbackMessage = feedbackError ?? feedbackSuccess;
    var feedbackType = feedbackError is not null ? "error" : "success";
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#e8edf5" />
    <title>@ViewData["Title"] - GamePrice</title>
    <link rel="icon" type="image/svg+xml" href="~/img/brand/gameprice-symbol.svg" asp-append-version="true" />
    <link rel="alternate icon" type="image/x-icon" href="~/favicon.ico" asp-append-version="true" />
    <link rel="stylesheet" href="/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    @if (!string.IsNullOrWhiteSpace(feedbackMessage))
    {
        <div class="site-notice @feedbackType site-feedback-fallback"
             data-site-feedback
             data-feedback-type="@feedbackType"
             role="@(feedbackType == "error" ? "alert" : "status")"
             hidden>
            @feedbackMessage
        </div>
    }

    <header class="site-header">
        <nav class="navbar navbar-expand-lg" aria-label="Navegação principal">
            <div class="container site-container">
                <a class="site-brand" asp-area="" asp-controller="Home" asp-action="Index" aria-label="GamePrice, página inicial">
                    <img class="site-brand-logo" src="~/img/brand/gameprice-logo.svg" alt="" width="184" height="44" asp-append-version="true" />
                </a>

                <button class="navbar-toggler site-menu-button" type="button" data-bs-toggle="collapse" data-bs-target="#siteNavigation" aria-controls="siteNavigation" aria-expanded="false" aria-label="Abrir navegação">
                    <i class="bi bi-list" aria-hidden="true"></i>
                </button>

                <div class="collapse navbar-collapse" id="siteNavigation">
                    <ul class="navbar-nav ms-auto align-items-lg-center site-nav-list">
                        <li class="nav-item"><a class="nav-link" asp-controller="Ofertas" asp-action="Ofertas">Ofertas</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="FreeGames" asp-action="FreeGames">Jogos grátis</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Recursos" asp-action="Recursos">Recursos</a></li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item dropdown site-account-menu">
                                <button class="btn btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-person" aria-hidden="true"></i>
                                    @accountName
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><a class="dropdown-item" asp-controller="Wishlist" asp-action="Wishlist"><i class="bi bi-bookmark" aria-hidden="true"></i>Lista de desejos</a></li>
                                    <li><a class="dropdown-item" asp-controller="Profile" asp-action="Settings"><i class="bi bi-gear" aria-hidden="true"></i>Configurações</a></li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        <form asp-controller="Login" asp-action="Logout" method="post">
                                            <button type="submit" class="dropdown-item"><i class="bi bi-box-arrow-right" aria-hidden="true"></i>Sair</button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item site-login-item">
                                <a class="btn btn-primary" asp-controller="Login" asp-action="Login">
                                    <i class="bi bi-person" aria-hidden="true"></i>
                                    Entrar
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main class="site-main">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container site-container">
            <div class="footer-main">
                <div class="footer-summary">
                    <a class="site-brand footer-brand" asp-controller="Home" asp-action="Index">
                        <img class="site-brand-logo" src="~/img/brand/gameprice-logo.svg" alt="GamePrice" width="184" height="44" asp-append-version="true" />
                    </a>
                    <p>Compare preços em lojas oficiais antes de escolher onde comprar.</p>
                </div>

                <nav class="footer-nav" aria-label="Links do rodapé">
                    <div>
                        <h2>Produto</h2>
                        <a asp-controller="Ofertas" asp-action="Ofertas">Ofertas</a>
                        <a asp-controller="FreeGames" asp-action="FreeGames">Jogos grátis</a>
                        <a asp-controller="Recursos" asp-action="Recursos">Recursos</a>
                    </div>
                    <div>
                        <h2>Legal</h2>
                        <a asp-controller="Terms" asp-action="Terms">Termos de uso</a>
                        <a asp-controller="Privacy" asp-action="Privacy">Privacidade</a>
                    </div>
                    <div>
                        <h2>Projeto</h2>
                        <a href="https://github.com/Gabriel-Oliveira-Prado/GamePrice" target="_blank" rel="noopener noreferrer">Código-fonte</a>
                        <a href="https://github.com/Gabriel-Oliveira-Prado/GamePrice.Api" target="_blank" rel="noopener noreferrer">API</a>
                        <a href="https://github.com/Gabriel-Oliveira-Prado/GamePrice.Scraper.git" target="_blank" rel="noopener noreferrer">Scraper</a>
                    </div>
                </nav>
            </div>

            <div class="footer-bottom">
                <span>&copy; 2026 GamePrice</span>
                <span>Recife, Brasil</span>
            </div>
        </div>
    </footer>

    <script src="/lib/jquery/dist/jquery.min.js"></script>
    <script src="/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="/js/notifications.js" asp-append-version="true"></script>
    <script src="/js/search.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
