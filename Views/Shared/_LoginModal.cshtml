<div class="modal fade" id="loginModal" tabindex="-1" aria-labelledby="loginModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content text-white login-modal-content">
            <div class="modal-header border-bottom-0 pt-4 px-4">
                <h5 class="modal-title fw-bold d-flex align-items-center" id="loginModalLabel">
                    <i class="fas fa-user-circle text-primary me-2 fs-4"></i> <span id="authTitle">Login</span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body px-4 pb-4">
                @* Login Form *@
                <div id="loginForm">
                    <form>
                        <div class="mb-3">
                            <label for="emailInput" class="form-label text-white small">Email:</label>
                            <div class="input-group">
                                <span class="input-group-text bg-dark border-white text-white"><i class="fas fa-envelope"></i></span>
                                <input type="email" autocomplete="email" class="form-control bg-dark border-white text-white shadow-none" id="emailInput" placeholder="seu@email.com">
                            </div>
                        </div>
                        <div class="mb-3">
                            <label for="passwordInput" class="form-label text-white small">Senha:</label>
                            <div class="input-group">
                                <span class="input-group-text bg-dark border-white text-white"><i class="fas fa-lock"></i></span>
                                <input type="password" autocomplete="current-password" class="form-control bg-dark border-white text-white shadow-none" id="passwordInput" placeholder="******">
                            </div>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <div class="form-check">
                                <input class="form-check-input bg-dark border-white shadow-none" type="checkbox" id="rememberCheck">
                                <label class="form-check-label text-white small" for="rememberCheck">Lembrar-me</label>
                            </div>
                            <a href="#" class="text-primary text-decoration-none small">Esqueceu a senha?</a>
                        </div>
                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary btn-glow fw-bold auth-submit-btn">Entrar</button>
                        </div>
                    </form>
                </div>

                @* Register Form *@
                <div id="registerForm" class="d-none">
                    <form>
                        <div class="mb-3">
                            <label for="regNameInput" class="form-label text-white small">Nome:</label>
                            <div class="input-group">
                                <span class="input-group-text bg-dark border-white text-white"><i class="fas fa-user"></i></span>
                                <input type="text" autocomplete="name" class="form-control bg-dark border-white text-white shadow-none" id="regNameInput" placeholder="Seu Nome">
                            </div>
                        </div>
                        <div class="mb-3">
                            <label for="regEmailInput" class="form-label text-white small">Email:</label>
                            <div class="input-group">
                                <span class="input-group-text bg-dark border-white text-white"><i class="fas fa-envelope"></i></span>
                                <input type="email" autocomplete="email" class="form-control bg-dark border-white text-white shadow-none" id="regEmailInput" placeholder="seu@email.com">
                            </div>
                        </div>
                        <div class="mb-3">
                            <label for="regPasswordInput" class="form-label text-white small">Senha:</label>
                            <div class="input-group">
                                <span class="input-group-text bg-dark border-white text-white"><i class="fas fa-lock"></i></span>
                                <input type="password" autocomplete="new-password" class="form-control bg-dark border-white text-white shadow-none" id="regPasswordInput" placeholder="******">
                            </div>
                        </div>
                        <div class="mb-3">
                            <label for="regConfirmPasswordInput" class="form-label text-white small">Confirmar Senha:</label>
                            <div class="input-group">
                                <span class="input-group-text bg-dark border-white text-white"><i class="fas fa-lock"></i></span>
                                <input type="password" autocomplete="new-password" class="form-control bg-dark border-white text-white shadow-none" id="regConfirmPasswordInput" placeholder="******">
                            </div>
                        </div>
                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary btn-glow fw-bold auth-submit-btn">Cadastrar</button>
                        </div>
                    </form>
                </div>

                <div class="position-relative my-4">
                    <hr class="border-secondary opacity-25">
                    <span class="position-absolute top-50 start-50 translate-middle px-2 text-white small login-divider-text">ou</span>
                </div>

                <div class="d-flex gap-3">
                    <button class="btn btn-outline-light flex-grow-1 d-flex align-items-center justify-content-center gap-2 social-login-btn">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 48 48">
                            <path fill="#FFC107" d="M43.611,20.083H42V20H24v8h11.303c-1.649,4.657-6.08,8-11.303,8c-6.627,0-12-5.373-12-12c0-6.627,5.373-12,12-12c3.059,0,5.842,1.154,7.961,3.039l5.657-5.657C34.046,6.053,29.268,4,24,4C12.955,4,4,12.955,4,24c0,11.045,8.955,20,20,20c11.045,0,20-8.955,20-20C44,22.659,43.862,21.35,43.611,20.083z" />
                            <path fill="#FF3D00" d="M6.306,14.691l6.571,4.819C14.655,15.108,18.961,12,24,12c3.059,0,5.842,1.154,7.961,3.039l5.657-5.657C34.046,6.053,29.268,4,24,4C16.318,4,9.656,8.337,6.306,14.691z" />
                            <path fill="#4CAF50" d="M24,44c5.166,0,9.86-1.977,13.409-5.192l-6.19-5.238C29.211,35.091,26.715,36,24,36c-5.202,0-9.619-3.317-11.283-7.946l-6.522,5.025C9.505,39.556,16.227,44,24,44z" />
                            <path fill="#1976D2" d="M43.611,20.083H42V20H24v8h11.303c-0.792,2.237-2.231,4.166-4.087,5.571c0.001-0.001,0.002-0.001,0.003-0.002l6.19,5.238C36.971,39.205,44,34,44,24C44,22.659,43.862,21.35,43.611,20.083z" />
                        </svg>
                        Google
                    </button>
                    <button class="btn btn-outline-light flex-grow-1 d-flex align-items-center justify-content-center gap-2 social-login-btn">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 384 512" fill="currentColor">
                            <path d="M318.7 268.7c-.2-36.7 16.4-64.4 50-84.8-18.8-26.9-47.2-41.7-84.7-44.6-35.5-2.8-74.3 20.7-88.5 20.7-15 0-49.4-19.7-76.4-19.7C63.3 141.2 4 184.8 4 273.5q0 39.3 14.4 81.2c12.8 36.7 59 126.7 107.2 125.2 25.2-.6 43-17.9 75.8-17.9 31.8 0 48.3 17.9 76.4 17.9 48.6-.7 90.4-82.5 102.6-119.3-65.2-30.7-61.7-90-61.7-91.9zm-56.6-164.2c27.3-32.4 24.8-61.9 24-72.5-24.1 1.4-52 16.4-67.9 34.3-17.5 19.8-27.8 44.3-25.6 71.9 26.1 2 52.3-11.4 69.5-34.3z" />
                        </svg>
                        Apple
                    </button>
                </div>
            </div>
            <div class="modal-footer border-top-0 justify-content-center pb-4">
                <div id="loginFooter">
                    <p class="mb-0 text-white small">Nao tem uma conta? <a href="#" class="text-primary text-decoration-none fw-bold" onclick="toggleAuth(event, 'register')">Cadastre-se</a></p>
                </div>
                <div id="registerFooter" class="d-none">
                    <p class="mb-0 text-white small">Ja tem uma conta? <a href="#" class="text-primary text-decoration-none fw-bold" onclick="toggleAuth(event, 'login')">Entrar</a></p>
                </div>
            </div>
        </div>
    </div>
</div>