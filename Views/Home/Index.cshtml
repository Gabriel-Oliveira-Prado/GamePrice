@{
    ViewData["Title"] = "GamePrice - O Melhor Preço para seu Jogo";
}
@* Hero Section *@
<section class="hero-section text-center position-relative">
    <div id="particles-js" class="particles-container"></div>
    <div class="hero-animation-container" id="hero-animation"></div>

    <div class="dropdown dropup position-absolute bottom-0 start-0 m-3 m-md-4 fade-in-up z-3 d-none d-md-inline-block">
        <button class="badge glass-effect text-primary px-3 py-2 rounded-pill border-0 shadow-none d-flex align-items-center gap-2" type="button" data-bs-toggle="dropdown" aria-expanded="false" data-bs-auto-close="outside">
            <span class="pulse-dot"></span> Monitoramento em Tempo Real <i class="bi bi-chevron-up status-text-xs"></i>
        </button>
        <div class="dropdown-menu dropdown-menu-dark shadow-lg rounded-4 p-3 border border-secondary status-menu-desktop status-menu-glass" id="desktop-status-menu">
        </div>
    </div>

    <div class="container position-relative hero-content-wrapper">
        <div class="row justify-content-center">
            <div class="col-lg-10">
                <div class="mb-4 fade-in-up d-md-none">
                    <button class="badge glass-effect text-primary px-3 py-2 rounded-pill border-0 shadow-none d-flex align-items-center gap-2 mx-auto" type="button" data-bs-toggle="collapse" data-bs-target="#mobileStatusCollapse" aria-expanded="false" aria-controls="mobileStatusCollapse">
                        <span class="pulse-dot"></span> Monitoramento em Tempo Real <i class="bi bi-chevron-down status-text-xs"></i>
                    </button>
                    <div class="collapse mt-3" id="mobileStatusCollapse">
                        <div class="card card-body shadow-lg rounded-4 p-3 border border-secondary mx-auto text-start status-menu-mobile status-menu-glass" id="mobile-status-menu">
                        </div>
                    </div>
                </div>
                <h1 class="hero-title text-white mb-4 fade-in-up">Não pague mais caro.<br>Encontre o <span class="text-highlight">menor preço.</span></h1>
                <div class="search-container fade-in-up mb-4 mx-auto">
                    <div class="position-relative z-3">
                        <input type="text" class="search-input" placeholder="Qual jogo você está procurando?">
                        <button class="search-btn" type="button"><i class="bi bi-search"></i></button>
                    </div>
                    @* Search Results*@
                    <div id="search-results" class="search-dropdown text-start rounded-3 shadow-lg mt-2"></div>
                </div>
                <p class="lead fade-in-up hero-lead-text">Comparamos preços da Steam, Epic Games, PS Store, Xbox e Nintendo Eshop em segundos. Receba alertas de promoções imperdíveis.</p>
                <div class="mt-5 d-flex flex-wrap justify-content-center gap-3 gap-md-4 small fade-in-up">
                    <span class="stat-item gs-reveal"><i class="fas fa-store text-primary me-1 fs-5"></i> <strong><span class="counter" data-target="8">0</span></strong> Lojas</span>
                    <span class="stat-item gs-reveal"><i class="fas fa-gamepad text-primary me-1 fs-5"></i> <strong>+<span class="counter" data-target="15000">0</span></strong> Jogos</span>
                    <span class="stat-item gs-reveal"><i class="fas fa-bell text-primary me-1 fs-5"></i> Alertas via <strong>Email e WhatsApp</strong></span>
                </div>
            </div>
        </div>
    </div> 
    @* Scroll Down Indicator *@
    <a href="#deals" class="scroll-indicator d-flex text-decoration-none">
        <span class="scroll-text">Descobrir</span>
        <div class="scroll-arrows">
            <i class="bi bi-chevron-down arrow-1"></i>
            <i class="bi bi-chevron-down arrow-2"></i>
            <i class="bi bi-chevron-down arrow-3"></i>
        </div>
    </a>
</section>
@* Brands Marquee *@
<section class="brands-section">
    <div class="marquee-content marquee-content-hover">
        <a href="https://store.steampowered.com" target="_blank" class="brand-item brand-steam text-decoration-none">STEAM</a>
        <a href="https://www.playstation.com" target="_blank" class="brand-item brand-ps text-decoration-none">PLAYSTATION</a>
        <a href="https://www.xbox.com" target="_blank" class="brand-item brand-xbox text-decoration-none">XBOX</a>
        <a href="https://www.epicgames.com/store" target="_blank" class="brand-item brand-epic text-decoration-none">EPIC GAMES</a>
        <a href="https://itch.io" target="_blank" class="brand-item brand-itch text-decoration-none">ITCH.IO</a>
        <a href="https://www.gog.com" target="_blank" class="brand-item brand-gog text-decoration-none">GOG.COM</a>
        <a href="https://www.nuuvem.com" target="_blank" class="brand-item brand-nuuvem text-decoration-none">NUUVEM</a>
        <a href="https://www.nintendo.com" target="_blank" class="brand-item brand-nintendo text-decoration-none">NINTENDO</a>
    </div>
</section>
@* Deals Section (Grid de Ofertas) *@
<section id="deals" class="py-5 position-relative">
    <div class="container py-4">
        <div class="text-center mb-5 gs-reveal">
            <h2 class="fw-bold text-white mb-2">Ofertas em <span class="text-primary">Destaques</span></h2>
            <p class="text-white">Os maiores descontos encontrados pelos nossos bots hoje.</p>
        </div>
        @* Filtros Rapidos *@
        <div class="d-flex justify-content-center flex-wrap gap-2 mb-5 gs-reveal">
            <span class="badge rounded-pill px-4 py-2 filter-pill active" data-filter="all">Todos</span>
            <span class="badge rounded-pill px-4 py-2 filter-pill" data-filter="pc"><i class="fas fa-desktop me-1"></i> PC</span>
            <span class="badge rounded-pill px-4 py-2 filter-pill" data-filter="playstation"><i class="fab fa-playstation me-1"></i> PlayStation</span>
            <span class="badge rounded-pill px-4 py-2 filter-pill" data-filter="xbox"><i class="fab fa-xbox me-1"></i> Xbox</span>
            <span class="badge rounded-pill px-4 py-2 filter-pill" data-filter="nintendo"><i class="bi bi-nintendo-switch me-1"></i> Nintendo</span>
            <span class="badge rounded-pill px-4 py-2 filter-pill" data-filter="under20">Abaixo de R$ 20</span>
        </div>
        @* Grid de Cards *@
        <div class="row g-4" id="deals-grid">
            @* Exemplo de Card Estático para Visualização (Substituir pela Api depois) *@
            <div class="col-md-4 col-lg-3">
                <div class="deal-card h-100">
                    <div class="position-relative">
                        <span class="badge bg-danger position-absolute top-0 start-0 m-3 shadow">-50%</span>
                        <img src="https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1091500/header.jpg" class="card-img-top" alt="Cyberpunk 2077">
                    </div>
                    <div class="p-4">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h5 class="text-white fw-bold mb-0 text-truncate">Cyberpunk 207732</h5>
                        </div>
                        <div class="d-flex align-items-center mb-3">
                            <i class="fab fa-steam text-white-50 me-2"></i>
                            <small class="text-white-50">Steam</small>
                        </div>
                        <a href="#" class="card-price-link text-decoration-none">
                            <div class="text-center mt-3 border-top border-secondary pt-3 price-hover-container">
                                <small class="text-decoration-line-through text-secondary price-old-text">R$ 199,90</small>
                                <div class="price-display">
                                    <i class="bi bi-box-arrow-up-right me-2 price-icon"></i>
                                    <span class="text-primary fw-bold fs-4 price-value">R$ 99,95</span>
                                </div>
                            </div>
                        </a>
                    </div>
                </div>
            </div>
            <div class="col-md-4 col-lg-3">
                <div class="deal-card h-100">
                    <div class="position-relative">
                        <span class="badge bg-danger position-absolute top-0 start-0 m-3 shadow">-75%</span>
                        <img src="https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/271590/header.jpg" class="card-img-top" alt="GTA V">
                    </div>
                    <div class="p-4">
                        <h5 class="text-white fw-bold mb-2">Grand Theft Auto V</h5>
                        <div class="d-flex align-items-center mb-3"><i class="fab fa-epic-games text-white-50 me-2"></i> <small class="text-white-50">Epic Games</small></div>
                        <a href="#" class="card-price-link text-decoration-none">
                            <div class="text-center mt-3 border-top border-secondary pt-3 price-hover-container">
                                <small class="text-decoration-line-through text-secondary price-old-text">R$ 89,90</small>
                                <div class="price-display">
                                    <i class="bi bi-box-arrow-up-right me-2 price-icon"></i>
                                    <span class="text-primary fw-bold fs-4 price-value">R$ 22,47</span>
                                </div>
                            </div>
                        </a>
                    </div>
                </div>
            </div>
        </div>
        <div class="text-center mt-5">
            <a href="#" class="btn btn-primary rounded-pill px-5 py-2 btn-glow">Ver Mais Ofertas</a>
        </div>
    </div>
</section>
