@model GamePrice.Models.HomeViewModel
@{
    ViewData["Title"] = "Compare preços de jogos";
}

<section class="hero-section">
    <div class="container site-container hero-content">
        <p class="eyebrow">Comparador de lojas oficiais</p>
        <h1>Encontre o menor preço do seu próximo jogo.</h1>
        <p class="hero-copy">Pesquise uma vez e compare ofertas de PC e consoles em um só lugar.</p>

        <div class="search-container">
            <label class="visually-hidden" for="game-search">Nome do jogo</label>
            <div class="search-control">
                <input id="game-search" type="search" class="search-input" placeholder="Digite o nome de um jogo..." autocomplete="off"
                       role="combobox" aria-autocomplete="list" aria-controls="search-results" aria-expanded="false" />
                <button class="search-btn" type="button" aria-label="Buscar jogo">
                    <i class="bi bi-search" aria-hidden="true"></i>
                    <span>Comparar</span>
                </button>
            </div>
            <div id="search-results" class="search-dropdown" role="listbox" aria-label="Jogos encontrados" aria-live="polite"></div>
        </div>

        <dl class="hero-facts">
            <div><dt>8</dt><dd>lojas monitoradas</dd></div>
            <div><dt>PC e consoles</dt><dd>em uma mesma busca</dd></div>
            <div><dt>Lojas oficiais</dt><dd>links diretos para compra</dd></div>
        </dl>
    </div>
</section>

<section class="store-strip" aria-labelledby="stores-title">
    <div class="container site-container">
        <div class="section-heading compact-heading">
            <div>
                <p class="eyebrow">Cobertura</p>
                <h2 id="stores-title">Lojas comparadas</h2>
            </div>
        </div>

        <div class="store-list">
            <a href="https://store.steampowered.com" target="_blank" rel="noopener noreferrer" class="store-link">
                <img src="~/img/stores/steam.svg" alt="" width="24" height="24" loading="lazy" />
                <span>Steam</span>
            </a>
            <a href="https://store.epicgames.com" target="_blank" rel="noopener noreferrer" class="store-link">
                <img src="~/img/stores/epic-games.svg" alt="" width="24" height="24" loading="lazy" />
                <span>Epic Games</span>
            </a>
            <a href="https://www.playstation.com" target="_blank" rel="noopener noreferrer" class="store-link">
                <img src="~/img/stores/playstation.svg" alt="" width="24" height="24" loading="lazy" />
                <span>PlayStation</span>
            </a>
            <a href="https://www.xbox.com" target="_blank" rel="noopener noreferrer" class="store-link">
                <img src="~/img/stores/xbox.svg" alt="" width="24" height="24" loading="lazy" />
                <span>Xbox</span>
            </a>
            <a href="https://www.nintendo.com" target="_blank" rel="noopener noreferrer" class="store-link" aria-label="Nintendo">
                <img class="store-logo-nintendo" src="~/img/stores/nintendo.svg" alt="Nintendo" width="84" height="22" loading="lazy" />
            </a>
            <a href="https://www.gog.com" target="_blank" rel="noopener noreferrer" class="store-link">
                <img src="~/img/stores/gog.svg" alt="" width="24" height="24" loading="lazy" />
                <span>GOG</span>
            </a>
            <a href="https://www.nuuvem.com" target="_blank" rel="noopener noreferrer" class="store-link" aria-label="Nuuvem">
                <img class="store-logo-wide" src="~/img/stores/nuuvem.svg" alt="Nuuvem" width="106" height="20" loading="lazy" />
            </a>
            <a href="https://itch.io" target="_blank" rel="noopener noreferrer" class="store-link">
                <img src="~/img/stores/itch-io.svg" alt="" width="24" height="24" loading="lazy" />
                <span>itch.io</span>
            </a>
        </div>
    </div>
</section>

<section id="deals" class="content-section deals-section">
    <div class="container site-container">
        <div class="section-heading">
            <div>
                <p class="eyebrow">Atualizado hoje</p>
                <h2>Ofertas em destaque</h2>
                <p>Uma seleção direta dos menores preços encontrados.</p>
            </div>
            <a asp-controller="Ofertas" asp-action="Ofertas" class="btn btn-outline-secondary">
                Ver todas
                <i class="bi bi-arrow-right" aria-hidden="true"></i>
            </a>
        </div>

        <div class="filter-bar" role="group" aria-label="Filtrar ofertas">
            <button type="button" class="filter-pill active" data-filter="all" aria-pressed="true">Todos</button>
            <button type="button" class="filter-pill" data-filter="pc" aria-pressed="false">PC</button>
            <button type="button" class="filter-pill" data-filter="playstation" aria-pressed="false">PlayStation</button>
            <button type="button" class="filter-pill" data-filter="xbox" aria-pressed="false">Xbox</button>
            <button type="button" class="filter-pill" data-filter="nintendo" aria-pressed="false">Nintendo</button>
            <button type="button" class="filter-pill" data-filter="under20" aria-pressed="false">Até R$ 20</button>
        </div>

        <div class="product-grid" id="deals-grid">
            @if (Model.Deals?.Count > 0)
            {
                @foreach (var game in Model.Deals)
                {
                    <article class="deal-item-card product-card" data-platform="@game.Platform" data-price="@game.Price">
                        <a href="/Search/Details?gameName=@Uri.EscapeDataString(game.Title)" class="product-link" aria-label="Comparar preços de @game.Title">
                            <div class="game-cover">
                                <img src="@game.Image" alt="Capa de @game.Title" loading="lazy" onerror="this.parentElement.classList.add('image-missing'); this.remove();" />
                                @if (!string.IsNullOrWhiteSpace(game.Discount))
                                {
                                    <span class="discount-label">@game.Discount</span>
                                }
                            </div>
                            <div class="product-body">
                                <div class="store-line">
                                    @await Html.PartialAsync("_StoreIcon", game.Store)
                                    <span>@game.Store</span>
                                </div>
                                <h3>@game.Title</h3>
                                <div class="price-block">
                                    <div>
                                        @if (!string.IsNullOrWhiteSpace(game.OldPrice))
                                        {
                                            <span class="old-price">R$ @game.OldPrice</span>
                                        }
                                        <strong>R$ @game.Price</strong>
                                    </div>
                                    <i class="bi bi-arrow-up-right" aria-hidden="true"></i>
                                </div>
                            </div>
                        </a>
                    </article>
                }
            }
            else
            {
                <div class="empty-state">
                    <i class="bi bi-tag" aria-hidden="true"></i>
                    <p>Nenhuma oferta em destaque no momento.</p>
                </div>
            }
        </div>
    </div>
</section>

<section class="content-section free-section">
    <div class="container site-container">
        <div class="section-heading">
            <div>
                <p class="eyebrow">Para resgatar</p>
                <h2>Jogos gratuitos</h2>
                <p>Títulos gratuitos e campanhas por tempo limitado.</p>
            </div>
            <a asp-controller="FreeGames" asp-action="FreeGames" class="btn btn-outline-secondary">
                Ver todos
                <i class="bi bi-arrow-right" aria-hidden="true"></i>
            </a>
        </div>

        <div class="product-grid free-grid">
            @if (Model.FreeGames?.Count > 0)
            {
                @foreach (var game in Model.FreeGames)
                {
                    <article class="product-card">
                        <a href="/Search/Details?gameName=@Uri.EscapeDataString(game.Title)"
                           class="product-link" aria-label="Ver detalhes de @game.Title">
                            <div class="game-cover">
                                <img src="@game.Image" alt="Capa de @game.Title" loading="lazy" onerror="this.parentElement.classList.add('image-missing'); this.remove();" />
                                <span class="free-label">Grátis</span>
                            </div>
                            <div class="product-body">
                                <div class="store-line">
                                    @await Html.PartialAsync("_StoreIcon", game.Store)
                                    <span>@game.Store</span>
                                </div>
                                <h3>@game.Title</h3>
                                <div class="price-block">
                                    <strong>@game.Price</strong>
                                    <i class="bi bi-arrow-up-right" aria-hidden="true"></i>
                                </div>
                            </div>
                        </a>
                    </article>
                }
            }
            else
            {
                <div class="empty-state">
                    <i class="bi bi-controller" aria-hidden="true"></i>
                    <p>Nenhum jogo gratuito disponível no momento.</p>
                </div>
            }
        </div>
    </div>
</section>

@if (User.Identity?.IsAuthenticated != true)
{
    <section class="account-callout">
        <div class="container site-container account-callout-inner">
            <div>
                <p class="eyebrow">Lista de desejos</p>
                <h2>Guarde seus jogos e acompanhe a próxima queda de preço.</h2>
            </div>
            <a class="btn btn-primary" asp-controller="Register" asp-action="Register">
                Criar conta
                <i class="bi bi-arrow-right" aria-hidden="true"></i>
            </a>
        </div>
    </section>
}

@section Scripts {
    <script src="~/js/deals.js" asp-append-version="true"></script>
}
