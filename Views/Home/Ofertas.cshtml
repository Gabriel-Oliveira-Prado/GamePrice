@model List<GamePrice.Api.Domain.DTOs.GameDealDto>
@{
    ViewData["Title"] = "Ofertas";
}

<section class="page-shell">
    <div class="container site-container">
        @await Html.PartialAsync("_Breadcrumb", "Ofertas em destaque")
        <header class="page-header">
            <h1>Ofertas em destaque</h1>
            <p>Preços encontrados nas lojas oficiais monitoradas pelo GamePrice.</p>
        </header>

        <div class="filter-bar" role="group" aria-label="Filtrar ofertas">
            <button type="button" class="filter-pill active" data-filter="all" aria-pressed="true">Todos</button>
            <button type="button" class="filter-pill" data-filter="pc" aria-pressed="false">PC</button>
            <button type="button" class="filter-pill" data-filter="playstation" aria-pressed="false">PlayStation</button>
            <button type="button" class="filter-pill" data-filter="xbox" aria-pressed="false">Xbox</button>
            <button type="button" class="filter-pill" data-filter="nintendo" aria-pressed="false">Nintendo</button>
            <button type="button" class="filter-pill" data-filter="under20" aria-pressed="false">Até R$ 20</button>
        </div>

        <div class="product-grid" id="deals-grid">
            @if (Model?.Count > 0)
            {
                @foreach (var game in Model)
                {
                    <article class="deal-item-card product-card" data-platform="@game.Platform" data-price="@game.Price">
                        <a href="/Search/Details?gameName=@Uri.EscapeDataString(game.Title)" class="product-link" aria-label="Comparar preços de @game.Title">
                            <div class="game-cover">
                                <img src="@game.Image" alt="Capa de @game.Title" loading="lazy" onerror="this.parentElement.classList.add('image-missing'); this.remove();" />
                                @if (!string.IsNullOrWhiteSpace(game.Discount))
                                {
                                    <span class="discount-label">@game.Discount</span>
                                }
                            </div>
                            <div class="product-body">
                                <div class="store-line">
                                    @await Html.PartialAsync("_StoreIcon", game.Store)
                                    <span>@game.Store</span>
                                </div>
                                <h3>@game.Title</h3>
                                <div class="price-block">
                                    <div>
                                        @if (!string.IsNullOrWhiteSpace(game.OldPrice))
                                        {
                                            <span class="old-price">R$ @game.OldPrice</span>
                                        }
                                        <strong>R$ @game.Price</strong>
                                    </div>
                                    <i class="bi bi-arrow-up-right" aria-hidden="true"></i>
                                </div>
                            </div>
                        </a>
                    </article>
                }
            }
            else
            {
                <div class="empty-state">
                    <i class="bi bi-tag" aria-hidden="true"></i>
                    <p>Nenhuma oferta disponível no momento.</p>
                </div>
            }
        </div>
    </div>
</section>

@section Scripts {
    <script src="~/js/deals.js" asp-append-version="true"></script>
}
