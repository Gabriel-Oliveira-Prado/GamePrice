@model List<GamePrice.Api.Domain.DTOs.GameDealDto>
@{
    ViewData["Title"] = "Jogos gratuitos";
}

<section class="page-shell">
    <div class="container site-container">
        @await Html.PartialAsync("_Breadcrumb", "Jogos gratuitos")
        <header class="page-header">
            <h1>Jogos gratuitos</h1>
            <p>Títulos gratuitos e campanhas temporárias reunidos em uma lista direta.</p>
        </header>

        <div class="product-grid">
            @if (Model?.Count > 0)
            {
                @foreach (var game in Model)
                {
                    <article class="product-card">
                        <a href="/Search/Details?gameName=@Uri.EscapeDataString(game.Title)"
                           class="product-link" aria-label="Ver detalhes de @game.Title">
                            <div class="game-cover">
                                <img src="@game.Image" alt="Capa de @game.Title" loading="lazy" onerror="this.parentElement.classList.add('image-missing'); this.remove();" />
                                <span class="free-label">Grátis</span>
                            </div>
                            <div class="product-body">
                                <div class="store-line">
                                    @await Html.PartialAsync("_StoreIcon", game.Store)
                                    <span>@game.Store</span>
                                </div>
                                <h3>@game.Title</h3>
                                <div class="price-block">
                                    <strong>@game.Price</strong>
                                    <i class="bi bi-arrow-up-right" aria-hidden="true"></i>
                                </div>
                            </div>
                        </a>
                    </article>
                }
            }
            else
            {
                <div class="empty-state">
                    <i class="bi bi-controller" aria-hidden="true"></i>
                    <p>Nenhum jogo gratuito disponível no momento.</p>
                </div>
            }
        </div>
    </div>
</section>
