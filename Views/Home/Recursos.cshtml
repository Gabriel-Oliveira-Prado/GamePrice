@{
    ViewData["Title"] = "Recursos";
}

<section class="page-shell">
    <div class="container site-container">
        @await Html.PartialAsync("_Breadcrumb", "Recursos")
        <header class="page-header">
            <h1>Recursos para decidir melhor</h1>
            <p>O essencial para comparar preços, acompanhar jogos e comprar em canais oficiais.</p>
        </header>

        <div class="resource-list">
            <article class="resource-row">
                <span class="resource-icon"><i class="bi bi-search" aria-hidden="true"></i></span>
                <h2>Busca unificada</h2>
                <p>Uma consulta percorre Steam, Epic Games, GOG, Nuuvem, PlayStation, Xbox e Nintendo.</p>
            </article>
            <article class="resource-row">
                <span class="resource-icon"><i class="bi bi-bell" aria-hidden="true"></i></span>
                <h2>Alertas de preço</h2>
                <p>Defina um valor alvo e acompanhe quando uma oferta chegar ao preço esperado.</p>
            </article>
            <article class="resource-row">
                <span class="resource-icon"><i class="bi bi-graph-down" aria-hidden="true"></i></span>
                <h2>Histórico de preços</h2>
                <p>Compare o valor atual com registros anteriores para avaliar a qualidade do desconto.</p>
            </article>
            <article class="resource-row">
                <span class="resource-icon"><i class="bi bi-controller" aria-hidden="true"></i></span>
                <h2>Curadoria gratuita</h2>
                <p>Reúna jogos gratuitos e campanhas de resgate em uma lista fácil de consultar.</p>
            </article>
            <article class="resource-row">
                <span class="resource-icon"><i class="bi bi-braces" aria-hidden="true"></i></span>
                <h2>API pública</h2>
                <p>Consuma dados de comparação em projetos, extensões e painéis próprios.</p>
            </article>
            <article class="resource-row">
                <span class="resource-icon"><i class="bi bi-shield" aria-hidden="true"></i></span>
                <h2>Lojas oficiais</h2>
                <p>Os resultados direcionam para distribuidores e lojas autorizadas, sem mercados cinzentos.</p>
            </article>
        </div>
    </div>
</section>
